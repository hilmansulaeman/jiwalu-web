---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<section class="sec" id="faq">
  <div class="wrap">
    <h2 class="h-lg">Pertanyaan</h2>
    <div class="faq">
      {items.map((it) => (
        <details><summary>{it.q}</summary><p>{it.a}</p></details>
      ))}
      <slot />
    </div>
  </div>
</section>
